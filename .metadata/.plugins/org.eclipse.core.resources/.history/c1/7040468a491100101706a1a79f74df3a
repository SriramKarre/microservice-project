package com.example.movieinfoservice.swagger;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import io.swagger.v3.oas.models.OpenAPI;
import io.swagger.v3.oas.models.info.Info;

@Configuration
public class SwaggerConfig {

	@Bean
	public OpenAPI movieCatalogOpenAPI() {
		return new OpenAPI().info(new Info().title("Movie Catalog Service API")
				.description("API documentation for the Movie Catalog Service").version("1.0.0"));
	}
}
